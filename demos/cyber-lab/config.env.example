# Cyber Lab - connection settings
# Copy this file to config.env and keep it next to cyber-lab.exe.

# SQL Server instance, e.g. localhost or localhost\SQLEXPRESS
SERVER=localhost
DATABASE=CyberLab
DRIVER=ODBC Driver 18 for SQL Server

# Leave both empty to use Windows authentication.
DB_USER=
DB_PASSWORD=

# Port for the app (opens http://127.0.0.1:PORT/login).
# 8001 so it can run next to obp-rest-demo (8000).
PORT=8001
