# OBP REST Demo - connection settings
# Copy this file to config.env and keep it next to obp-rest-demo.exe.

# SQL Server instance, e.g. localhost, localhost\SQLEXPRESS, tcp:myserver.database.windows.net,1433
SERVER=localhost
DATABASE=OBPRestDemo
DRIVER=ODBC Driver 18 for SQL Server

# Leave both empty to use Windows authentication.
# Write the password without quotes; use single quotes only if it contains a space or #.
DB_USER=
DB_PASSWORD=

# Port for the API (Swagger opens at http://127.0.0.1:PORT/docs)
PORT=8000
